# KiCad lock, backup and cache files
~*.lck
*.lck
*-backups/
_autosave-*
*.bak
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache
*.kicad_prl

# Routing work area: board snapshots and autorouter scratch (regenerated by the scripts)
route/

# Design-check tool output
analysis/

# OpenSCAD console logs
*.echo

# Python
__pycache__/
*.pyc

# KiCad 10 local history (its own git store)
.history/
